 void SDL_SYS_WaitThread(SDL_Thread *thread)
 {
     OS3_ThreadData *td = (OS3_ThreadData *)thread->handle;
+    BYTE sigbit;
 
     if (td == NULL) {
         return;
     }
 
-    DLOG("WaitThread: waiting on mask=0x%lx for thread=%p name=%s",
-         td->parent_sigmask, (void *)thread,
+    DLOG("WaitThread: task=%p waits for thread=%p name=%s",
+         (void *)FindTask(NULL), (void *)thread,
          thread->name ? thread->name : "(null)");
 
-    /* Wait for the child to signal us before it exits.
-     * Per ADCD III-17: Wait() on the signal the child will send.
-     * No polling, no reading freed task memory. */
-    Wait(td->parent_sigmask);
-
-    DLOG("WaitThread: signal received, child signaled exit");
-
-    /* The child called Forbid() before Signal(), so by the time we
-     * wake up from Wait(), the child has already returned from
-     * OS3_ThreadEntry() and DOS process cleanup is complete (the
-     * Forbid is broken by the process exit path in RemTask/Switch).
-     *
-     * A small delay ensures the scheduler has fully processed the
-     * child's removal. Delay(1) = one tick (~20ms). */
-    Delay(1);
+    /* A bit of the calling task's own, for this wait only. */
+    sigbit = AllocSignal(-1);
+
+    Forbid();
+    if (!td->ended) {
+        if (sigbit != -1) {
+            td->waiter_sigbit = sigbit;
+            td->waiter = FindTask(NULL);
+            /* Wait() inside Forbid() is allowed: it lets other tasks run
+             * while this one sleeps and is back in Forbid() when it wakes,
+             * so the thread cannot end between the test and the Wait(). */
+            while (!td->ended) {
+                Wait(1UL << sigbit);
+            }
+        } else {
+            /* No bit free in this task: look once a tick. */
+            while (!td->ended) {
+                Permit();
+                Delay(1);
+                Forbid();
+            }
+        }
+    }
+    td->waiter = NULL;
+    Permit();
 
-    DLOG("WaitThread: cleanup delay done, freeing sigbit=%d",
-         (int)td->parent_sigbit);
+    DLOG("WaitThread: thread=%p has ended", (void *)thread);
 
-    /* Now safe to free the signal bit and the thread data. */
-    FreeSignal(td->parent_sigbit);
-    SDL_free(td);
+    if (sigbit != -1) {
+        FreeSignal(sigbit);
+    }
+
+    /* The thread's process may still be in DOS's exit code (which can wait
+     * for a file system as it frees the thread's locks) but no longer runs
+     * any of SDL's. A tick lets it finish before the caller goes on, as
+     * before. */
+    Delay(1);
+
+    FreeVec(td);
     thread->handle = NULL;
 }
 
 void SDL_SYS_DetachThread(SDL_Thread *thread)
 {
     OS3_ThreadData *td = (OS3_ThreadData *)thread->handle;
+    int ended;
 
-    /* Detached threads run independently. Free the signal bit
-     * since nobody will Wait on it. The child will Signal() into
-     * the void (harmless -- the bit is freed, signal is ignored). */
+    /* Detached threads run independently and free their OS3_ThreadData
+     * as they end; one that has already ended is freed here. */
     if (td != NULL) {
-        FreeSignal(td->parent_sigbit);
-        SDL_free(td);
+        Forbid();
+        ended = td->ended;
+        if (!ended) {
+            td->detached = 1;
+        }
+        Permit();
+        if (ended) {
+            FreeVec(td);
+        }
     }
     thread->handle = NULL;
 }
