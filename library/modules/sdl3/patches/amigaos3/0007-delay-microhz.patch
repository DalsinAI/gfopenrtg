SDL3_68k's timer (Zlib): SDL_Delay waited in dos.library's 1/50 s ticks,
so every sleep was a multiple of 20 ms. A sleep now waits on timer.device's
UNIT_MICROHZ with a reply port and request for each task, made the first
time it sleeps and freed when its thread ends, at SDL_Quit, or when the
program ends. AmiCradle Team, 2026.

--- a/src/timer/amigaos3/SDL_systimer.c
+++ b/src/timer/amigaos3/SDL_systimer.c
@@ -88,42 +88,126 @@
 Uint64 SDL_GetPerformanceCounter(void)
 {
     struct EClockVal now;
 
     if (!OS3_InitEClock()) {
         return 0;
     }
 
     ReadEClock(&now);
     return OS3_EClockToU64(&now);
 }
 
 Uint64 SDL_GetPerformanceFrequency(void)
 {
     if (!OS3_InitEClock()) {
         return 1000;
     }
     return (Uint64)eclock_freq;
 }
 
+/* AmigaOS 3.x (AmiCradle Team, 2026): a sleep waits on timer.device's
+   UNIT_MICROHZ, so SDL_Delay(1) is about a millisecond. dos.library's
+   Delay() counts 1/50 s ticks: every sleep was a multiple of 20 ms, and a
+   game holding its frame rate with SDL_Delay ran at 25 or 50 frames a
+   second. Each task that sleeps has its own reply port and request, made
+   the first time it sleeps and kept in SDL's thread-local storage: SDL
+   frees them when its thread ends, and the program's own task's at
+   SDL_Quit, or when the program ends if it never called SDL_Quit (that
+   port's signal is the Shell's). Without timer.device a sleep is Delay()'s,
+   as before. */
+static SDL_TLSID delay_tls;
+
+static void SDLCALL OS3_FreeDelayTimer(void *data)
+{
+    struct timerequest *tr = (struct timerequest *)data;
+    struct MsgPort *port;
+
+    if (!tr) {
+        return;
+    }
+    port = tr->tr_node.io_Message.mn_ReplyPort;
+    CloseDevice((struct IORequest *)tr);
+    DeleteIORequest((struct IORequest *)tr);
+    DeleteMsgPort(port);
+}
+
+/* The calling task's request, made the first time it sleeps; NULL when
+   timer.device can't be opened. */
+static struct timerequest *OS3_DelayTimer(void)
+{
+    struct timerequest *tr = (struct timerequest *)SDL_GetTLS(&delay_tls);
+    struct MsgPort *port;
+
+    if (tr) {
+        return tr;
+    }
+    port = CreateMsgPort();
+    if (!port) {
+        return NULL;
+    }
+    tr = (struct timerequest *)CreateIORequest(port, sizeof(struct timerequest));
+    if (!tr) {
+        DeleteMsgPort(port);
+        return NULL;
+    }
+    if (OpenDevice((CONST_STRPTR)TIMERNAME, UNIT_MICROHZ, (struct IORequest *)tr, 0) != 0) {
+        DeleteIORequest((struct IORequest *)tr);
+        DeleteMsgPort(port);
+        return NULL;
+    }
+    if (!SDL_SetTLS(&delay_tls, tr, OS3_FreeDelayTimer)) {
+        OS3_FreeDelayTimer(tr);
+        return NULL;
+    }
+    return tr;
+}
+
+/* The program's own task's request, when SDL_Quit hasn't freed it: this
+   runs in that task as the program ends. */
+__attribute__((destructor)) static void OS3_QuitDelayTimer(void)
+{
+    struct timerequest *tr;
+
+    if (!SDL_GetAtomicInt(&delay_tls)) {
+        return;
+    }
+    tr = (struct timerequest *)SDL_GetTLS(&delay_tls);
+    if (tr) {
+        SDL_SetTLS(&delay_tls, NULL, NULL);
+        OS3_FreeDelayTimer(tr);
+    }
+}
+
 void SDL_SYS_DelayNS(Uint64 ns)
 {
-    Uint64 ms;
+    struct timerequest *tr;
+    Uint64 ms, us;
     ULONG ticks;
 
     if (ns == 0) {
         Delay(0);
         return;
     }
 
+    tr = OS3_DelayTimer();
+    if (tr) {
+        us = (ns + 999ULL) / 1000ULL;               /* never shorter than asked */
+        tr->tr_node.io_Command = TR_ADDREQUEST;
+        tr->tr_time.tv_secs = us / 1000000ULL > 0xFFFFFFFFULL ? 0xFFFFFFFFUL : (ULONG)(us / 1000000ULL);
+        tr->tr_time.tv_micro = (ULONG)(us % 1000000ULL);
+        DoIO((struct IORequest *)tr);
+        return;
+    }
+
     /* dos.library Delay() is VBlank-tick based.  Round upward so the
        requested delay is never shortened.  Classic PAL uses 50 Hz;
        this deliberately favours portability over sub-tick precision. */
     ms = (ns + 999999ULL) / 1000000ULL;
     ticks = (ULONG)((ms + 19ULL) / 20ULL);
     if (ticks == 0) {
         ticks = 1;
     }
     Delay(ticks);
 }
 
 #endif /* SDL_TIMER_AMIGAOS3 || SDL_TIMERS_DISABLED */
