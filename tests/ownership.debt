# The ownership debt: every file that breaks a single-owner rule today, one line a rule and file.
# tests/ownership_check.sh reads it. A line may be deleted, never added: when its stage of
# docs/design/OpenGPU-Shared-Pipe-Plan.md lands, the code moves to its owner and the line goes with it.
# The check fails on a violation that isn't here, and on a line here that is no longer a violation.
#
# rule            file                                                              # the stage that clears it

# MiniGL's virgl route: its own blocks, resources, arenas, state objects, shaders, caps and present
virgl-cmd         library/minigl/mgl_vg.h                                           # M7
acv-present       library/minigl/mgl_vg_os3.c                                       # M8

# Warp3D's virgl route, and its stream3d builder
virgl-cmd         library/warp3d/w3d_vg.c                                           # M6
acv-present       library/warp3d/w3d_vg.c                                           # M8
acv-present       library/warp3d/w3d_vg_os3.c                                       # M8

# GL.module (Mesa): the listed exception keeps its own virgl driver, but not its own caps, board lookup or present
board-open        library/modules/gl/gla/os3/gla_notice_os3.c                       # MQ (why virgl wasn't used: from OGPU_Query)
acv-present       library/modules/gl/gla/gla_core.h                                 # M8
acv-present       library/modules/gl/gla/os3/gla_present_os3.c                      # M8
mesa-present      library/modules/gl/gla/os3/gla_present_os3.c                      # M8

# SDL 2 and 3: their renderer draws SDL_RenderGeometry's triangles with the stream's 3D command
stream3d          library/modules/sdl2/patches/sdl2/0004-opengpu-renderer.patch     # to decide: the pipe, or the allowed list beside OGFX's 2D
stream3d          library/modules/sdl3/patches/sdl3/0004-opengpu-renderer.patch     # to decide, as SDL 2's
