+#ifdef __amigaos3__
+/* AmigaOS 3 (Open), altered by the AmiCradle Team, 2026: an SDL 2 RWops of
+   SDL_RWFromFile and the others is SDL2.module's, and its functions reach the
+   module's data through A4, which only a call through SDL2.module's table
+   sets (include/gfopengpu/module.h). Called straight from here they ran on
+   the program's A4 and never came back (SDL_LoadWAV's first seek, a
+   program's first read). So these go through SDL 2's calls. */
+#define RWOPS20_SEEK(rw, o, w) SDL20_RWseek(rw, o, w)
+#define RWOPS20_READ(rw, p, s, n) SDL20_RWread(rw, p, s, n)
+#define RWOPS20_WRITE(rw, p, s, n) SDL20_RWwrite(rw, p, s, n)
+#define RWOPS20_CLOSE(rw) SDL20_RWclose(rw)
+#else
+#define RWOPS20_SEEK(rw, o, w) (rw)->seek(rw, o, w)
+#define RWOPS20_READ(rw, p, s, n) (rw)->read(rw, p, s, n)
+#define RWOPS20_WRITE(rw, p, s, n) (rw)->write(rw, p, s, n)
+#define RWOPS20_CLOSE(rw) (rw)->close(rw)
+#endif
+
