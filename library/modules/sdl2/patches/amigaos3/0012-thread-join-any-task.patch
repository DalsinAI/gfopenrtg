+/* Per-thread context stored in SDL_Thread->handle. Exec memory, not
+ * SDL_malloc's: the thread frees it as it ends when it was detached, and
+ * every field is read and written only under Forbid(). */
 typedef struct {
-    struct Task *parent_task;   /* task to signal on thread exit */
-    ULONG parent_sigmask;       /* signal mask (1 << allocated bit) */
-    BYTE parent_sigbit;         /* the allocated signal bit */
+    struct Task *waiter;        /* the task in SDL_SYS_WaitThread, or NULL */
+    BYTE waiter_sigbit;         /* its signal bit for the wait */
+    UBYTE ended;                /* the thread has finished SDL_RunThread */
+    UBYTE detached;             /* nobody will wait: the thread frees this */
 } OS3_ThreadData;
 
+/* The thread's last act: say that it has ended, and wake the task waiting
+ * for it if there is one; whichever task that is, the signal bit is its
+ * own. A detached thread frees its OS3_ThreadData instead.
+ *
+ * Forbid() first, and no Permit(): the process's exit breaks the Forbid()
+ * (RemTask -> Switch). So the waiter cannot run until this process has
+ * returned from OS3_ThreadEntry, and cannot let the program end (and the
+ * module's code go) while SDL's code still runs here. */
+static void OS3_ThreadEnded(OS3_ThreadData *td)
+{
+    Forbid();
+    if (td->detached) {
+        FreeVec(td);
+    } else {
+        td->ended = 1;
+        if (td->waiter) {
+            DLOG("ThreadEntry: signal waiter=%p bit=%d",
+                 (void *)td->waiter, (int)td->waiter_sigbit);
+            Signal(td->waiter, 1UL << td->waiter_sigbit);
+        }
+    }
+    /* Do NOT Permit() -- let DOS process exit break the Forbid. */
+}
