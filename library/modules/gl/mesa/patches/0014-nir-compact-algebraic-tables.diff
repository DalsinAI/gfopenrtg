+class CompactTables(object):
+    """The automaton's tables as the C code stores them (GFOpenGPU,
+    mesa/patches/0014; nir_search.h's struct per_op_table).
+
+    - Each distinct filter and table is emitted once. A filter whose
+      values all fit a byte (all of them in Mesa 26.2.4) is paged: the
+      number of a 32-byte block for each 32 states, each distinct block
+      stored once for the pass (<pass>_filter_pages).
+    - A table for an opcode with k >= 2 sources may be a row table: the
+      first n^(k-1) entries are, for each combination of the first k-1
+      sources' filtered states (in itertools.product() order), the number
+      of a row of n entries, stored after them, which the last source's
+      filtered state indexes. Identical rows are stored once. It is used
+      when it is smaller than the dense table.
+    - Identical per-state transform lists are stored once.
+
+    Every lookup is checked here against the dense tables of the original
+    generator, entry for entry, so the automaton finds the same states and
+    tries the same transforms in the same order.
+    """
+
+    PAGE = 32   # NIR_SEARCH_FILTER_PAGE (nir_search.h)
+
+    def __init__(self, pass_name, automaton, xforms):
+        self.arrays = []
+        self.ops = []
+        names = {}
+        pages = {}
+        filter_checks = []
+
+        def array(kind, ctype, vals):
+            key = (ctype, tuple(vals))
+            if key not in names:
+                name = '{}_{}{}'.format(pass_name, kind, len(self.arrays))
+                names[key] = name
+                self.arrays.append((name, ctype, key[1]))
+            return names[key]
+
+        for op in automaton.opcodes:
+            filt = automaton.filter[op]
+            n = len(automaton.rep[op])
+            assert 0 < n <= 0xffff
+            table = automaton.table[op]
+            num_srcs = len(next(iter(table)))
+            dense = [table[indices] for indices in
+                     itertools.product(range(n), repeat=num_srcs)]
+            assert all(0 <= s <= 0xffff for s in dense)
+
+            e = {'n': n, 'filter': None, 'filter_pages': None, 'row_table': 0}
+            if not all(f == 0 for f in filt):
+                if max(filt) <= 0xff:
+                    # paged: the number of each PAGE-state block, the blocks shared by the pass
+                    blocks = []
+                    for b in range(0, len(filt), self.PAGE):
+                        blk = tuple(filt[b:b + self.PAGE])
+                        blk += (0,) * (self.PAGE - len(blk))
+                        if blk not in pages:
+                            pages[blk] = len(pages)
+                        blocks.append(pages[blk])
+                    e['filter'] = array('filter', 'uint16_t', blocks)
+                    e['filter_pages'] = pass_name + '_filter_pages'
+                    filter_checks.append((op, filt, blocks))
+                else:
+                    e['filter'] = array('filter', 'uint16_t', filt)
+
+            stored = dense
+            if num_srcs >= 2:
+                row_of = {}
+                index, rows = [], []
+                for r in range(0, len(dense), n):
+                    row = tuple(dense[r:r + n])
+                    if row not in row_of:
+                        row_of[row] = len(rows)
+                        rows.append(row)
+                    index.append(row_of[row])
+                compact = index + [s for row in rows for s in row]
+                if len(compact) < len(dense) and len(rows) <= 0xffff:
+                    stored = compact
+                    e['row_table'] = 1
+            e['table'] = array('table', 'uint16_t', stored)
+            self.ops.append((op, e))
+
+            # The check: nir_algebraic_automaton()'s lookup on what is
+            # stored gives the dense table's state for every combination
+            # of the sources' filtered states (the filters below).
+            assert len(filt) == len(automaton.states)
+            for indices in itertools.product(range(n), repeat=num_srcs):
+                assert self.lookup(e, stored, indices) == table[indices], (pass_name, op, indices)
+
+        # The filters' pages, and the check: nir_search_filter() on what is
+        # stored gives the filter's value for every state.
+        if pages:
+            assert len(pages) <= 0xffff
+            flat = [v for blk in sorted(pages, key=pages.get) for v in blk]
+            self.arrays.append((pass_name + '_filter_pages', 'uint8_t', tuple(flat)))
+            for op, filt, blocks in filter_checks:
+                for s, f in enumerate(filt):
+                    assert self.filter_lookup(blocks, flat, s) == f, (pass_name, op, s)
+
+        # The per-state transform lists, each distinct list once.
+        sp, offs = automaton.state_patterns, automaton.state_pattern_offsets
+        self.state_patterns = [None]
+        self.state_pattern_offsets = []
+        at = {(): 0}
+        for o in offs:
+            pats = []
+            if o != 0:
+                i = o
+                while sp[i] is not None:
+                    pats.append(sp[i])
+                    i += 1
+            pats = tuple(pats)
+            if pats not in at:
+                at[pats] = len(self.state_patterns)
+                self.state_patterns.extend(pats)
+                self.state_patterns.append(None)
+            self.state_pattern_offsets.append(at[pats])
+        assert len(self.state_pattern_offsets) == len(offs)
+        assert all(o <= 0xffff for o in self.state_pattern_offsets)
+        for o_old, o_new in zip(offs, self.state_pattern_offsets):
+            i, j = o_old, o_new
+            while True:
+                assert sp[i] == self.state_patterns[j]
+                if o_old == 0 or sp[i] is None:
+                    break
+                i += 1
+                j += 1
+        # struct transform's condition_offset is a uint16_t now, and
+        # UINT16_MAX ends a list.
+        for i in self.state_patterns:
+            if i is not None:
+                assert 0 <= xforms[i].condition_index < 0xffff
+
+    @classmethod
+    def filter_lookup(cls, blocks, flat, s):
+        """nir_search_filter() for a paged filter (nir_search.h)."""
+        return flat[blocks[s // cls.PAGE] * cls.PAGE + s % cls.PAGE]
+
+    @staticmethod
+    def lookup(e, stored, fs):
+        """nir_algebraic_automaton()'s index arithmetic (nir_search.c)."""
+        n, index, rows = e['n'], 0, 1
+        head = len(fs) - 1 if e['row_table'] else len(fs)
+        for i, f in enumerate(fs):
+            if i == head:
+                index = rows + stored[index] * n + f
+            else:
+                index = index * n + f
+                rows *= n
+        return stored[index]
+
