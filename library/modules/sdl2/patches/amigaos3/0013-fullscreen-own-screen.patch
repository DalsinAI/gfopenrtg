+/* --- Internal: the full-screen window's screen on RTG (Open, 2026) --- */
+/* The mode SDL has picked for a full-screen window, and the screen depth
+   for it: 16 for a 15 or 16-bit mode, 32 otherwise (OS3_OpenScreen asks for
+   24 when a board's 32-bit mode says 24). */
+static void OS3_FullscreenMode(SDL_Window *window, int *w, int *h, int *depth)
+{
+    SDL_DisplayMode mode;
+
+    SDL_zero(mode);
+    if (SDL_GetWindowDisplayMode(window, &mode) < 0 || mode.w <= 0 || mode.h <= 0) {
+        mode.w = window->w;
+        mode.h = window->h;
+    }
+    *w = mode.w;
+    *h = mode.h;
+    *depth = (mode.format && SDL_BYTESPERPIXEL(mode.format) == 2) ? 16 : 32;
+}
+
+/* A screen in that mode, w x h (or, failing that, the smallest RTG mode
+   that holds it), and a borderless window filling it. */
+static int OS3_OpenModeScreen(OS3_WindowData *data, int w, int h, int depth)
+{
+    ULONG modeid;
+
+    modeid = BestCModeIDTags(
+        CYBRBIDTG_NominalWidth,  w,
+        CYBRBIDTG_NominalHeight, h,
+        CYBRBIDTG_Depth,         depth,
+        TAG_DONE
+    );
+    if (modeid == INVALID_ID) {
+        /* P96/SAGA fallback */
+        modeid = OS3_FindRTGMode(w, h, depth > 24 ? 24 : depth);
+    }
+    if (modeid == INVALID_ID) {
+        return SDL_SetError("OS3: no RTG mode for a %dx%d full screen", w, h);
+    }
+    return OS3_OpenScreen(data, w, h, modeid, depth);
+}
+
