+/* GFOpenGPU (mesa/patches/0014): the automaton's tables are stored
+ * compactly, and identical ones are emitted once.
+ *
+ * A filter (state -> filtered state) whose values fit a byte is paged:
+ * filter_pages holds blocks of NIR_SEARCH_FILTER_PAGE bytes, each distinct
+ * block once for the whole pass, and filter[] the number of the block for
+ * each NIR_SEARCH_FILTER_PAGE states. Without filter_pages, filter[] is the
+ * plain uint16_t filter, as before.
+ *
+ * A table with row_table set is a table of rows: the first n^(k-1) entries
+ * give, for the first k-1 sources' filtered states, the number of a row of
+ * n entries stored after them, indexed by the last source's filtered state.
+ * Identical rows are stored once (nir_opt_algebraic's bcsel table goes from
+ * 5.1 MB to about 250 KB).
+ *
+ * The states found are the dense tables' own: nir_algebraic.py checks every
+ * lookup against them as it emits the tables.
+ */
+#define NIR_SEARCH_FILTER_PAGE_SHIFT 5
+#define NIR_SEARCH_FILTER_PAGE (1u << NIR_SEARCH_FILTER_PAGE_SHIFT)
+
 struct per_op_table {
    const uint16_t *filter;
-   unsigned num_filtered_states;
+   const uint8_t *filter_pages;
    const uint16_t *table;
+   uint16_t num_filtered_states;
+   uint16_t row_table;
 };
 
+static inline unsigned
+nir_search_filter(const struct per_op_table *tbl, uint16_t state)
+{
+   if (!tbl->filter)
+      return 0;
+   if (!tbl->filter_pages)
+      return tbl->filter[state];
+   return tbl->filter_pages[((unsigned)tbl->filter[state >> NIR_SEARCH_FILTER_PAGE_SHIFT]
+                             << NIR_SEARCH_FILTER_PAGE_SHIFT) |
+                            (state & (NIR_SEARCH_FILTER_PAGE - 1))];
+}
+
 struct transform {
    uint16_t search;  /* Index in table->values[] for the search expression. */
    uint16_t replace; /* Index in table->values[] for the replace value. */
-   unsigned condition_offset;
+   uint16_t condition_offset;
 };
 
