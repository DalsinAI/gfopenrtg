diff --git a/src/audio/SDL_audio.c b/src/audio/SDL_audio.c
index 8c859de..7e131c2 100644
--- a/src/audio/SDL_audio.c
+++ b/src/audio/SDL_audio.c
@@ -46,6 +46,35 @@ typedef struct AudioThreadStartupData
 static SDL_AudioDriver current_audio;
 static SDL_AudioDevice *open_devices[16];
 
+#ifdef __AMIGAOS3__
+/* Open (2026): Right Amiga + P (video/amigaos3/SDL_os3keys.c) stops every
+   open device and starts again the ones it stopped. */
+static Uint32 os3_paused_by_us;
+
+void SDL_OS3_PauseAllAudio(int pause)
+{
+    int i;
+
+    for (i = 0; i < (int)SDL_arraysize(open_devices) && i < 32; i++) {
+        SDL_AudioDevice *device = open_devices[i];
+        if (!device) {
+            continue;
+        }
+        if (pause) {
+            if (!SDL_AtomicGet(&device->paused)) {
+                SDL_AtomicSet(&device->paused, 1);
+                os3_paused_by_us |= 1UL << i;
+            }
+        } else if (os3_paused_by_us & (1UL << i)) {
+            SDL_AtomicSet(&device->paused, 0);
+        }
+    }
+    if (!pause) {
+        os3_paused_by_us = 0;
+    }
+}
+#endif
+
 /* Available audio drivers */
