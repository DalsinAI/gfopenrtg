+/* --- Internal: the screens of our own that Intuition would not close --- */
+/* Open (2026): CloseScreen fails while a window is still open on the
+ * screen, and another program's can be (a commodity that puts a window on
+ * the front screen). The result was not looked at: the screen stayed in
+ * front, in its own mode, with nothing left to close it (the grey screen,
+ * and the Workbench shown in the full screen's display mode). Such a screen
+ * now goes behind the Workbench and is closed as soon as Intuition lets us:
+ * on the next screen we close, and in OS3_ReleaseScreens (VideoQuit). */
+#define OS3_MAX_LEFTOVER_SCREENS 4
+static struct Screen *os3_leftover_screens[OS3_MAX_LEFTOVER_SCREENS];
+
+static void OS3_RetryLeftoverScreens(void)
+{
+    int i;
+
+    for (i = 0; i < OS3_MAX_LEFTOVER_SCREENS; i++) {
+        if (os3_leftover_screens[i] && CloseScreen(os3_leftover_screens[i])) {
+            os3_leftover_screens[i] = NULL;
+        }
+    }
+}
+
+static void OS3_CloseOwnScreen(struct Screen *screen)
+{
+    int i;
+
+    if (CloseScreen(screen)) {
+        return;
+    }
+    ScreenToBack(screen);
+    for (i = 0; i < OS3_MAX_LEFTOVER_SCREENS; i++) {
+        if (!os3_leftover_screens[i]) {
+            os3_leftover_screens[i] = screen;
+            return;
+        }
+    }
+}
+
+/* --- Internal: the Workbench back in front, in its own mode, repainted --- */
+/* Open (2026): after a screen of our own has closed. Intuition shows the
+ * next screen when one closes, but an RTG board was left in the closed
+ * screen's mode: a 640x480 full screen over an 800x600 Workbench left the
+ * Workbench as four squashed copies in stripes on AmigaOS 3.2.3, and SDL's
+ * SetDisplayMode has nothing to undo (the window owns its screen). So the
+ * Workbench is brought to the front and Intuition remakes the whole display,
+ * which sets the board's mode from the front screen again. Then a window
+ * over the whole Workbench, opened without drawing and closed at once, has
+ * Intuition and layers repaint everything under it: what the program drew
+ * full screen (FULLSCREEN_DESKTOP is in the Workbench's own mode) no longer
+ * stays on the Workbench outside the program's window. */
+static void OS3_BackToWorkbench(void)
+{
+    struct Screen *wb;
+    struct Window *cover;
+
+    OS3_RetryLeftoverScreens();
+    wb = LockPubScreen(NULL);
+    if (!wb) {
+        WBenchToFront();
+        RemakeDisplay();
+        return;
+    }
+    ScreenToFront(wb);
+    RemakeDisplay();
+    cover = OpenWindowTags(NULL,
+        WA_PubScreen,     (ULONG)wb,
+        WA_Left,          0,
+        WA_Top,           0,
+        WA_Width,         (ULONG)wb->Width,
+        WA_Height,        (ULONG)wb->Height,
+        WA_Borderless,    TRUE,
+        WA_Activate,      FALSE,
+        WA_RMBTrap,       TRUE,
+        WA_SimpleRefresh, TRUE,
+        WA_NoCareRefresh, TRUE,
+        WA_BackFill,      (ULONG)LAYERS_NOBACKFILL,
+        WA_IDCMP,         0,
+        TAG_DONE
+    );
+    if (cover) {
+        CloseWindow(cover);
+    }
+    UnlockPubScreen(NULL, wb);
+}
+
+/* VideoQuit: a screen Intuition would not close before, closed now if it
+   can be, else left behind the Workbench; the Workbench in front. */
+void OS3_ReleaseScreens(void)
+{
+    int i, any = 0;
+
+    for (i = 0; i < OS3_MAX_LEFTOVER_SCREENS; i++) {
+        if (os3_leftover_screens[i]) {
+            any = 1;
+        }
+    }
+    if (!any) {
+        return;
+    }
+    OS3_RetryLeftoverScreens();
+    for (i = 0; i < OS3_MAX_LEFTOVER_SCREENS; i++) {
+        if (os3_leftover_screens[i]) {
+            ScreenToBack(os3_leftover_screens[i]);
+            os3_leftover_screens[i] = NULL;
+        }
+    }
+    WBenchToFront();
+}
