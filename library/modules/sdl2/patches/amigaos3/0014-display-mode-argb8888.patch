+/* A CyberGraphX mode's format (Open, 2026). CYBRIDATTR_DEPTH says 24 for a
+   board's 32-bit modes as well as its 24-bit ones; their pixels are 4 bytes
+   (CYBRIDATTR_BPPIX), and the window surface SDL gives on such a screen is
+   ARGB8888. Reported as RGB24, a program that sized its pixels by the
+   display mode drew 3-byte pixels into the 4-byte surface (Powermanga). */
+static Uint32 OS3_CyberModeFormat(ULONG modeid, ULONG depth)
+{
+    if (depth == 24 && GetCyberIDAttr(CYBRIDATTR_BPPIX, modeid) == 4) {
+        return SDL_PIXELFORMAT_ARGB8888;
+    }
+    return OS3_DepthToFormat(depth);
+}
