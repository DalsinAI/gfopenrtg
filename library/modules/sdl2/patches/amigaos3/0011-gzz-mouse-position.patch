+/* An IntuiMessage gives the mouse relative to the window's outer corner,
+ * a GimmeZeroZero window's too (OS 3.2.3, and OpenIntuition since 26 Oct
+ * 2026); its GZZMouseX and GZZMouseY, not its messages, are inside the
+ * borders. SDL's windows on the Workbench are GimmeZeroZero and draw inside
+ * the borders, so the borders come off here. Before, every click landed the
+ * title bar's height below the pointer (Freeciv's buttons at the foot of
+ * its window could not be pressed, 2 Nov 2026). */
+static void OS3_InnerMouse(const struct Window *iwin, WORD *x, WORD *y)
+{
+    if (iwin->Flags & WFLG_GIMMEZEROZERO) {
+        *x -= iwin->BorderLeft;
+        *y -= iwin->BorderTop;
+    }
+}
+
