diff --git a/src/timer/amigaos3/SDL_systimer.c b/src/timer/amigaos3/SDL_systimer.c
index 3d8e647..ca1817c 100644
--- a/src/timer/amigaos3/SDL_systimer.c
+++ b/src/timer/amigaos3/SDL_systimer.c
@@ -48,6 +48,43 @@ static ULONG eclock_freq = 0;       /* E-Clock ticks per second */
 static struct EClockVal eclock_start; /* value at SDL_TicksInit */
 static int timer_initialized = 0;
 
+/* Open (2026): Right Amiga + P (video/amigaos3/SDL_os3keys.c) stops the
+   game's clock: the time spent paused is left out of SDL_GetTicks and the
+   performance counter, so a game that runs by the clock doesn't jump on. */
+static Uint64 os3_paused_total = 0;  /* E-Clock ticks */
+static Uint64 os3_paused_at = 0;     /* while paused, when it began */
+static int os3_paused = 0;
+
+static Uint64 OS3_ClockNow(void)
+{
+    struct EClockVal now;
+
+    ReadEClock(&now);
+    return (((Uint64)now.ev_hi << 32) | (Uint64)now.ev_lo);
+}
+
+static Uint64 OS3_GameClock(void)
+{
+    return (os3_paused ? os3_paused_at : OS3_ClockNow()) - os3_paused_total;
+}
+
+void SDL_OS3_TimerPause(int pause)
+{
+    if (!timer_initialized) {
+        SDL_TicksInit();
+    }
+    if (!timer_initialized || pause == os3_paused) {
+        return;
+    }
+    if (pause) {
+        os3_paused_at = OS3_ClockNow();
+        os3_paused = 1;
+    } else {
+        os3_paused_total += OS3_ClockNow() - os3_paused_at;
+        os3_paused = 0;
+    }
+}
+
 
 /* Combine EClockVal hi/lo into a 64-bit value */
 static SDL_INLINE Uint64 eclock_to_u64(const struct EClockVal *ev)
@@ -133,10 +170,9 @@ Uint64 SDL_GetTicks64(void)
         return 0;
     }
 
-    ReadEClock(&now);
-
+    (void)now;
     start = eclock_to_u64(&eclock_start);
-    current = eclock_to_u64(&now);
+    current = OS3_GameClock();
     delta_ticks = current - start;
 
     /* Convert to milliseconds.
@@ -166,8 +202,8 @@ Uint64 SDL_GetPerformanceCounter(void)
         return 0;
     }
 
-    ReadEClock(&now);
-    return eclock_to_u64(&now);
+    (void)now;
+    return OS3_GameClock();
 }
 
 Uint64 SDL_GetPerformanceFrequency(void)
